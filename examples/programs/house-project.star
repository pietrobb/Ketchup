#
# Spoje: kde do seba diely zasahujú (čap stĺpika v prahu, priečka v stĺpiku, krokva
# na väznici), prijímajúci diel má zárez presne podľa vloženého dielu. Pravouhlé
# zárezy sú v zozname výrezov dielu, ostatné sú na konci súboru: narez(diel, sused)
# vyreže tvar suseda (jeho hranol alebo profil), zarez(diel, sused) suseda aj s jeho
# vlastnými zárezmi. Kontrola kolízií preto nehlási žiadne prekrytie.

D = {}
K = {}
#
# Spoje: kde do seba diely zasahujú (čap stĺpika v prahu, priečka v stĺpiku, krokva
# na väznici), prijímajúci diel má zárez presne podľa vloženého dielu. Pravouhlé
# zárezy sú v zozname výrezov dielu, ostatné sú na konci súboru: narez(diel, sused)
# vyreže tvar suseda (jeho hranol alebo profil), zarez(diel, sused) suseda aj s jeho
# vlastnými zárezmi. Kontrola kolízií preto nehlási žiadne prekrytie.

D = {}
K = {}
#
# Spoje: kde do seba diely zasahujú (čap stĺpika v prahu, priečka v stĺpiku, krokva
# na väznici), prijímajúci diel má zárez presne podľa vloženého dielu. Pravouhlé
# zárezy sú v zozname výrezov dielu, ostatné sú na konci súboru: narez(diel, sused)
# vyreže tvar suseda (jeho hranol alebo profil), zarez(diel, sused) suseda aj s jeho
# vlastnými zárezmi. Kontrola kolízií preto nehlási žiadne prekrytie.

D = {}
K = {}
#
# Spoje: kde do seba diely zasahujú (čap stĺpika v prahu, priečka v stĺpiku, krokva
# na väznici), prijímajúci diel má zárez presne podľa vloženého dielu. Pravouhlé
# zárezy sú v zozname výrezov dielu, ostatné sú na konci súboru: narez(diel, sused)
# vyreže tvar suseda (jeho hranol alebo profil), zarez(diel, sused) suseda aj s jeho
# vlastnými zárezmi. Kontrola kolízií preto nehlási žiadne prekrytie.

D = {}
K = {}
#
# Spoje: kde do seba diely zasahujú (čap stĺpika v prahu, priečka v stĺpiku, krokva
# na väznici), prijímajúci diel má zárez presne podľa vloženého dielu. Pravouhlé
# zárezy sú v zozname výrezov dielu, ostatné sú na konci súboru: narez(diel, sused)
# vyreže tvar suseda (jeho hranol alebo profil), zarez(diel, sused) suseda aj s jeho
# vlastnými zárezmi. Kontrola kolízií preto nehlási žiadne prekrytie.

D = {}
K = {}

def kus(name, size, at, x, z, tags, material, color, cuts):
    p = box(name, size, material = material, color = color, tags = tags)
    place(p, origin = at, z = z, x = x)
    for i, cut in enumerate(cuts):
        t = box("%s / výrez %d" % (name, i + 1), cut[1], tool = True)
        place(t, origin = cut[0], z = z, x = x)
        subtract(p, t, name = "výrez %d" % (i + 1))
    D[name] = p
    K[name] = (size, None, at, x, z)

def profil(name, points, distance, at, x, z, tags, material, color, holes):
    p = extrude(name, profile = points, distance = distance, material = material, color = color, tags = tags)
    place(p, origin = at, z = z, x = x)
    for i, hole in enumerate(holes):
        t = extrude("%s / otvor %d" % (name, i + 1), profile = hole, distance = distance + 2, tool = True)
        place(t, origin = vec_sub(at, z), z = z, x = x)
        subtract(p, t, name = "otvor %d" % (i + 1))
    D[name] = p
    K[name] = (points, distance, at, x, z)

def narez(name, other):
    shape, distance, at, x, z = K[other]
    if distance == None:
        t = box("%s / tvar %s" % (name, other), shape, tool = True)
    else:
        t = extrude("%s / tvar %s" % (name, other), profile = shape, distance = distance, tool = True)
    place(t, origin = at, z = z, x = x)
    subtract(D[name], t, name = "zárez pre " + other)

def zarez(name, other):
    subtract(D[name], D[other], name = "zárez pre " + other)

def rozdel(name, point, normal):
    D[name + " b"] = split(D[name], point, normal, name = name + " b")


