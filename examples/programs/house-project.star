# House project — drevená konštrukcia domu prevzatá zo SketchUpu.
#
# Každý viditeľný diel zo SketchUpu je tu presné teleso: hranol (s výrezmi a zárezmi
# ako booleovské odčítanie) alebo vytiahnutý profil (šikmo zrezané krokvy, vzpery,
# schodnice). Súradnice v mm, x = 0 je roh domu (v SketchUpe x = -14480).
#
# Vrstvy (tagy) sa dajú vypínať po celkoch aj po jednotlivých vrstvách. Každý diel má
# tag celku a tag svojej vrstvy; skrytím ktoréhokoľvek z nich sa diel skryje:
#   1 Základy    — 1.1 pätky, 1.2 základ komína
#   2 Prízemie   — 2.1 hlavné nosníky, 2.2 podlahové trámy, 2.3 prahy, 2.4 stĺpiky,
#                  2.5 priečky, 2.6 preklady, 2.7 väznice, 2.8 stropné trámy
#   3 Poschodie  — 3.1 prahy, 3.2 stĺpiky, 3.3 priečky, 3.4 preklady, 3.5 väznice,
#                  3.6 stropné trámy
#   4 Strecha    — 4.1 trámy, 4.2 nosníky, 4.3 stojky, 4.4 vzpery, 4.5 väznice,
#                  4.6 kliešťiny, 4.7 krokvy, 4.8 trojuholníky
#   5 Komín, 6 Balkón (6.1 nosníky, 6.2 podlaha, 6.3 zábradlie), 7 Kuchyňa, 8 Schody
#
# Súbor je vygenerovaný zo SketchUpu; diely nie sú parametrické.
#
# Tesárske prvky: každý drevený diel je rovný hranol (miestna os z = dĺžka) a všetko,
# čo z neho tesár alebo CNC (Hundegger) odoberie, je samostatný rez: hranolový nástroj
# s obrysom a hĺbkou, umiestnený vo svete. Rezy sú šikmé zrezania („obrys“), pôvodné
# výrezy, otvory a zárezy pre susedné diely („zárez pre …“): prijímajúci diel má zárez
# presne podľa vloženého dielu, takže kontrola kolízií nehlási žiadne prekrytie.
# Pravouhlé zárezy vchádzajú do dielu z jeho plochy, kade sú najplytšie.
# Betónové pätky a komín nie sú tesárske prvky.

TESAR = {"classification:ketchup.fabrication-role.v1": "fabrication.timber-member.v1"}

def tram(name, size, at, x, z, tags, material, color, cuts):
    """Tesársky prvok: hranol `size` (šírka, výška, dĺžka) s rohom v `at`, dĺžka pozdĺž z.
    Každý rez je (názov, obrys, hĺbka, počiatok, x, z): obrys v rovine x/y nástroja
    vytiahnutý o hĺbku pozdĺž z, odčítaný od prvku."""
    diel(name, size, at, x, z, tags, material, color, cuts, TESAR)

def diel(name, size, at, x, z, tags, material, color, cuts, attributes = {}):
    """Hranol s rezmi ako tram(), ale nie tesársky prvok (betón, dosky)."""
    p = box(name, size, material = material, color = color, tags = tags, attributes = attributes)
    place(p, origin = at, z = z, x = x)
    for cut in cuts:
        label, outline, depth, origin, cx, cz = cut
        t = extrude("%s / %s" % (name, label), profile = outline, distance = depth, tool = True)
        place(t, origin = origin, z = cz, x = cx)
        subtract(p, t, name = label)


