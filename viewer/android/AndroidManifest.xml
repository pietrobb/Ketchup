<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="sk.ketchup.viewer"
    android:versionCode="1"
    android:versionName="0.1.0">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="36" />
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x400003" android:required="false" />
    <application
        android:label="Kečup Viewer"
        android:hasCode="true"
        android:extractNativeLibs="true">
        <activity
            android:name="sk.ketchup.viewer.ViewerActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|uiMode"
            android:launchMode="singleTask">
            <meta-data android:name="android.app.lib_name" android:value="ketchup_viewer_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Packages arrive from mail and chat apps as untyped content and
                 comment files as JSON; the Viewer checks what they are on opening. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/json" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>
        <!-- Lends shared comment files read-only to the app picked in the share sheet. -->
        <provider
            android:name="sk.ketchup.viewer.SharedFiles"
            android:authorities="sk.ketchup.viewer.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
